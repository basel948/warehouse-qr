# Prisma / SQLite
DATABASE_URL="file:./dev.db"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Seed admin account (used by prisma/seed.ts)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""

# WhatsApp Cloud API (Meta) - https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WAREHOUSE_OWNER_PHONE=""

# Cloudinary (product image uploads) - https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Order email notifications (SendGrid HTTPS API - https://sendgrid.com)
# Raw SMTP (e.g. Gmail) doesn't work from most cloud hosts, Railway included -
# they block outbound SMTP ports as an anti-spam measure, so email must go
# through an HTTPS API instead.
# SENDGRID_API_KEY: from Settings > API Keys in your SendGrid account
# SENDGRID_FROM_EMAIL: the address you verified under Settings > Sender
#   Authentication > Single Sender Verification
# WAREHOUSE_OWNER_EMAIL: where order PDFs are sent
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
WAREHOUSE_OWNER_EMAIL=""

# remove.bg (one-off local image background removal script) - https://www.remove.bg/api
REMOVEBG_API_KEY=""

# Public base URL, used to build the QR code target
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Branding shown in the site header and admin nav
NEXT_PUBLIC_WAREHOUSE_NAME="Your Warehouse"
NEXT_PUBLIC_WAREHOUSE_LOGO_URL=""
NEXT_PUBLIC_WAREHOUSE_ACCENT_COLOR="#8a3a2e"

# Phone number shown to buyers in the site footer (call + WhatsApp links).
# Same format as WAREHOUSE_OWNER_PHONE (country code, no + or leading 0s).
NEXT_PUBLIC_WAREHOUSE_CONTACT_PHONE=""
