// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  // Where "forgot password" links go; falls back to WAREHOUSE_OWNER_EMAIL.
  email        String?
  createdAt    DateTime @default(now())
  passwordResetTokens PasswordResetToken[]
}

// One-time "forgot password" links. Only a SHA-256 hash of the token is
// stored, so a leaked database can't be used to reset a password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  order         Int           @default(0)
  // Home page tile image; a transparent PNG of the category's products works
  // best, since the tile lets the image rise above its background strip.
  imageUrl      String?
  createdAt     DateTime      @default(now())
  products      Product[]
  subcategories Subcategory[]
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  order      Int       @default(0)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  createdAt  DateTime  @default(now())
  products   Product[]

  @@unique([categoryId, name])
}

model Product {
  id            String       @id @default(cuid())
  name          String
  description   String?
  price         Float
  imageUrl      String?
  inStock       Boolean      @default(true)
  onSale        Boolean      @default(false)
  // Position chosen by the admin ("arrange products"); category pages list
  // products by it. Lower = earlier. New products go to the end.
  sortOrder     Int          @default(0)
  salePrice     Float?
  saleBannerImageUrl String?
  categories    Category[]
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  subcategoryId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orderItems    OrderItem[]
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  customerName    String
  businessName    String      @default("")
  customerPhone   String
  status          String      @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  paymentMethod   String      @default("CASH") // CASH | CREDIT | PAY_LATER
  settledAt       DateTime? // pay-later orders only: when the buyer's monthly statement was marked paid
  whatsappSentAt  DateTime?
  buyerWhatsappSentAt DateTime?
  emailSentAt     DateTime?
  couponCode      String?
  discountPercent Int?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float
}
