// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  // Where "forgot password" links go; falls back to WAREHOUSE_OWNER_EMAIL.
  email        String?
  createdAt    DateTime @default(now())
  passwordResetTokens PasswordResetToken[]
}

// One-time "forgot password" links. Only a SHA-256 hash of the token is
// stored, so a leaked database can't be used to reset a password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  order         Int           @default(0)
  // Home page tile image; a transparent PNG of the category's products works
  // best, since the tile lets the image rise above its background strip.
  imageUrl      String?
  createdAt     DateTime      @default(now())
  products      Product[]
  subcategories Subcategory[]
  coupons       Coupon[]      @relation("CouponCategories")
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  order      Int       @default(0)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  createdAt  DateTime  @default(now())
  products   Product[]

  @@unique([categoryId, name])
}

model Product {
  id            String       @id @default(cuid())
  name          String
  description   String?
  price         Float
  // The main photo (shown on the card, in the cart, the PDF and the admin).
  imageUrl      String?
  // Secondary photos, in order, shown after the main one in the shop's
  // details window. The admin picks which photo is main; the rest live here.
  images        String[]     @default([])
  inStock       Boolean      @default(true)
  onSale        Boolean      @default(false)
  // Position chosen by the admin ("arrange products"); category pages list
  // products by it. Lower = earlier. New products go to the end.
  sortOrder     Int          @default(0)
  // How the product is sold and counted: "UNIT" (יחידה) or "CARTON" (קרטון).
  // See src/lib/product-unit.ts.
  unit          String       @default("UNIT")
  // Units in the warehouse, in `unit`. Null = not tracked (works as before).
  // Orders reduce it; cancelling an order puts it back; at 0 the product
  // turns out of stock.
  stockQuantity Int?
  // Options shown as one card in the shop (e.g. a fork in 3 colours, a cup in
  // 6 sizes): each option is still its own product (own price, stock, photo),
  // linked to a shared VariantGroup. variantLabel is the option's name on the
  // card ("שחור", "8OZ"); variantOrder its place among the options.
  variantGroupId String?
  variantGroup   VariantGroup? @relation(fields: [variantGroupId], references: [id], onDelete: SetNull)
  variantLabel   String?
  variantOrder   Int           @default(0)
  salePrice     Float?
  saleBannerImageUrl String?
  categories    Category[]
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  subcategoryId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orderItems    OrderItem[]
  // This product's price for each customer type (school, restaurant…).
  // A type without a row here pays `price` (the base price).
  typePrices    ProductTypePrice[]
}

// One shop card holding several products as options. Its name is the card's
// title; the photo is the chosen option's (or the first option with one).
model VariantGroup {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  products  Product[]
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  // Empty = the coupon applies to the whole order; otherwise only to products
  // in one of these categories.
  categories      Category[] @relation("CouponCategories")
}

model Order {
  id              String      @id @default(cuid())
  customerName    String
  businessName    String      @default("")
  customerPhone   String
  status          String      @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  paymentMethod   String      @default("CASH") // CASH | CREDIT | PAY_LATER
  settledAt       DateTime? // pay-later orders only: when the buyer's monthly statement was marked paid
  whatsappSentAt  DateTime?
  buyerWhatsappSentAt DateTime?
  emailSentAt     DateTime?
  // Since multiple coupons per order: the codes that discounted something,
  // joined with ", " (for display); the discount itself is per item
  // (OrderItem.discountPercent) and discountPercent here stays null. Orders
  // from before that have one code and an order-wide discountPercent.
  couponCode      String?
  discountPercent Int?
  // VAT (מע"מ) rate charged on top of the prices, as a snapshot like
  // discountPercent. Null = an order from before VAT was added at checkout.
  vatPercent      Int?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
  // The buyer's ח.פ / עוסק מורשה number at order time (snapshot).
  businessId       String    @default("")
  // Buyers see no prices: an order arrives as a request (item prices null),
  // the owner fills in the prices in the admin (pricedAt), then sends the
  // buyer a WhatsApp link to the priced PDF (sentToBuyerAt). shareToken is
  // the secret in that link (/q/<token>); set when the order is first priced.
  pricedAt         DateTime?
  sentToBuyerAt    DateTime?
  shareToken       String?   @unique
  // The logged-in buyer who placed it, and their customer type's name at that
  // moment (a snapshot, like the prices). Null on orders from before buyer login.
  buyer            Buyer?   @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerId          String?
  customerTypeName String?
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  // Before VAT. Null until the owner prices the order (buyers see no prices).
  price     Float?
  // True while this line's quantity is taken off the product's stock, so a
  // cancelled order returns exactly what it took (and orders from before stock
  // tracking return nothing).
  stockDeducted Boolean @default(false)
  // Snapshot of the coupon that discounted this line (the biggest one that
  // covered it), or null. Null on orders from before per-item coupons.
  couponCode      String?
  discountPercent Int?
}

// Customer types and their price lists. Not used by the app at the moment
// (buyers see no prices; the owner prices each order by hand). The tables are
// kept so the owner's data survives if price lists come back.
model CustomerType {
  id        String             @id @default(cuid())
  name      String
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  prices    ProductTypePrice[]
  buyers    Buyer[]
}

// One product's price (before VAT) for one customer type.
model ProductTypePrice {
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  customerType   CustomerType @relation(fields: [customerTypeId], references: [id], onDelete: Cascade)
  customerTypeId String
  price          Float

  @@id([productId, customerTypeId])
}

// A buyer who signed up in the shop (first name, business name, ח.פ, phone).
// Identified by phone (normalised, src/lib/phone.ts): signing up again with
// the same phone updates the details. Checkout can update them too.
model Buyer {
  id             String        @id @default(cuid())
  phone          String        @unique
  customerType   CustomerType? @relation(fields: [customerTypeId], references: [id], onDelete: SetNull)
  customerTypeId String?
  // First name (שם פרטי).
  name           String        @default("")
  businessName   String        @default("")
  // ח.פ / עוסק מורשה: digits only (src/lib/business-id.ts).
  businessId     String        @default("")
  lastLoginAt    DateTime      @default(now())
  createdAt      DateTime      @default(now())
  orders         Order[]
}
